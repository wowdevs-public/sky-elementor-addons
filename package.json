  "scripts": {
    "wpbuild": "wp-scripts build",
    "packages-update": "wp-scripts packages-update",
    "start": "wp-scripts start",
    "start:hot": "wp-scripts start --hot",
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "find . -name .DS_Store -delete && rimraf ./assets && rimraf ./sky-elementor-addons",
    "dev": "npm run clean && cross-env NODE_ENV=development grunt",
    "build": "npm run clean && cross-env NODE_ENV=production grunt && npm run wpbuild && npm run make-pot",
    "zip": "npm run && npm run build && rsync -av --exclude-from=.buildignore . sky-elementor-addons && zip -r sky-elementor-addons-v.$npm_package_version.zip sky-elementor-addons/* && npm run copyDemo",
    "make-pot": "wp i18n make-pot . languages/sky-elementor-addons.pot --exclude=node_modules,build,vendor,assets,src",
    "copyDemo": "cp -R /Users/shahidul/Documents/local/wowdevs/app/public/wp-content/plugins/sky-elementor-addons/sky-elementor-addons/* /Users/shahidul/Documents/local/skyaddons/app/public/wp-content/plugins/sky-elementor-addons/"
